    {
      "parameters": {
        "sendTo": "={{ $json.body.email }}",
        "subject": "=Welcome to Camorra Hair, {{ $json.body.name }} 💇🏾‍♀️",
        "emailType": "html",
        "message": "=<div style=\"font-family:Arial,Helvetica,sans-serif;max-width:520px;margin:auto;color:#2e1220\"><div style=\"background:#3a1426;color:#fff;padding:28px 24px;border-radius:16px 16px 0 0\"><div style=\"font-size:26px;font-weight:700;font-family:Georgia,serif\">camorra hair</div></div><div style=\"background:#fbf4f1;padding:24px;border-radius:0 0 16px 16px\"><h2 style=\"margin:0 0 12px\">Welcome, {{ $json.body.name }} 💇🏾‍♀️</h2><p style=\"line-height:1.6;margin:0 0 12px\">Thank you for joining Camorra Hair. You can now save your favourite units, check out in seconds and track every delivery live, right to your door.</p><p style=\"line-height:1.6;margin:0 0 20px\">Use code <b>WELCOME10</b> for 10% off your first unit.</p><a href=\"#\" style=\"display:inline-block;background:#b8436f;color:#fff;text-decoration:none;padding:12px 22px;border-radius:999px;font-weight:700\">Shop new units</a><p style=\"color:#93707e;font-size:12px;margin-top:24px\">Camorra Hair · Lekki, Lagos</p></div></div>",
        "options": {
          "senderName": "Camorra Hair",
          "appendAttribution": false
        }
      },
      "id": "3ec9e470-a790-4ee8-adb4-05bd1d794f48",
      "name": "Welcome Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        300,
        0
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "camorra-hair-order",
        "responseMode": "onReceived",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "0bc96024-3f52-465a-a656-648a949c5897",
      "name": "Order Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        320
      ],
      "webhookId": "4db0288f-b83e-4d74-8a76-d11dc273b089"
    },
    {
      "parameters": {
        "sendTo": "={{ $json.body.email }}",
        "subject": "=Your Camorra Hair order #{{ $json.body.orderId }} is confirmed ✓",
        "emailType": "html",
        "message": "=<div style=\"font-family:Arial,Helvetica,sans-serif;max-width:520px;margin:auto;color:#2e1220\"><div style=\"background:#3a1426;color:#fff;padding:28px 24px;border-radius:16px 16px 0 0\"><div style=\"font-size:26px;font-weight:700;font-family:Georgia,serif\">camorra hair</div><div style=\"opacity:.8;margin-top:6px\">Order #{{ $json.body.orderId }} is confirmed ✓</div></div><div style=\"background:#fbf4f1;padding:24px;border-radius:0 0 16px 16px\"><h2 style=\"margin:0 0 12px\">Thank you, {{ $json.body.name }}!</h2><p style=\"line-height:1.6;margin:0 0 16px\">We have received your payment. Your unit is being styled and packed, and you can watch your rider live in the app once it is on the way.</p><div style=\"background:#fff;border:1px solid #efdde2;border-radius:12px;padding:16px;line-height:1.7\">{{ $json.body.itemsText.split(\"\\n\").join(\"<br>\") }}<hr style=\"border:0;border-top:1px dashed #efdde2;margin:12px 0\">Delivery: {{ $json.body.delivery }}<br>Payment: {{ $json.body.payment }}<br><b style=\"font-size:18px\">Total: {{ $json.body.totalText }}</b></div><p style=\"color:#93707e;font-size:12px;margin-top:24px\">Questions? Just reply to this email. · Camorra Hair, Lekki, Lagos</p></div></div>",
        "options": {
          "senderName": "Camorra Hair",
          "appendAttribution": false
        }
      },
      "id": "d0decef7-a286-44cb-86a0-988d8a58982d",
