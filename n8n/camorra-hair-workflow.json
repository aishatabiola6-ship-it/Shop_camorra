    {
      "parameters": {
        "httpMethod": "POST",
        "path": "camorra-hair-signup",
        "responseMode": "onReceived",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "6d2e3983-df36-4bc5-b75a-476b54205bec",
      "name": "Sign-up Webhook",
